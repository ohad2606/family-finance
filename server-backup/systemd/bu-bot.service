[Unit]
Description=BU Bot Telegram AI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bu_bot
Environment=PATH=/home/ubuntu/venv/bin
ExecStart=/home/ubuntu/venv/bin/python3 /home/ubuntu/bu_bot/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
